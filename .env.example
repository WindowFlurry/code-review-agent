# Copy this file to `.env` and fill in your key.  NEVER commit `.env`.
#
#   cp .env.example .env
#
# If you already use Claude Code against DeepSeek (ANTHROPIC_BASE_URL=https://api.deepseek.com),
# the token in your environment IS a DeepSeek API key and works here as-is.

# ---- required ----
# Without this, `codereview review` refuses to run rather than silently
# producing a deterministic-only report. Use `review --offline` for that.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- model ----
# NOTE: `deepseek-chat` is obsolete. Use `deepseek-flash`.
# Older tutorials and even the LangChain integration page still say deepseek-chat -> 404.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- LLM behaviour ----
# DeepSeek thinking mode is ON by default and SILENTLY IGNORES temperature=0.
# Deterministic nodes (plan / verify / report) set DISABLE_THINKING=true.
DISABLE_THINKING=true
# Reviewer nodes use thinking for better bug detection: low | high | max
REASONING_EFFORT=high

# ---- optional fallback provider (Qwen / DashScope, OpenAI-compatible) ----
# Leave blank to disable automatic failover.
DASHSCOPE_API_KEY=
FALLBACK_MODEL=qwen3-max
FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- review limits ----
MAX_FILES=40
MAX_FILE_BYTES=262144
MAX_CONCURRENCY=4
LLM_TIMEOUT_S=120

# ---- Windows: avoid GBK console UnicodeEncodeError ----
PYTHONUTF8=1
